FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/mathweb/backend
WORKDIR /opt/mathweb
COPY backend/requirements-question-factory.txt backend/requirements.txt /opt/mathweb/backend/
RUN python -m pip install --no-cache-dir -r backend/requirements-question-factory.txt
COPY backend/ /opt/mathweb/backend/
WORKDIR /opt/mathweb/backend
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1"]
