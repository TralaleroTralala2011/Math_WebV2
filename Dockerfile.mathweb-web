FROM nginx:1.27-alpine
COPY nginx.mathweb.conf /etc/nginx/conf.d/default.conf
COPY *.html /usr/share/nginx/html/
COPY learning-path.js /usr/share/nginx/html/learning-path.js
COPY js/ /usr/share/nginx/html/js/
COPY css/ /usr/share/nginx/html/css/
COPY games/ /usr/share/nginx/html/games/
COPY effects/ /usr/share/nginx/html/effects/
COPY learn-assets/ /usr/share/nginx/html/learn-assets/
# Only public frontend files are shipped. The database, .env, source Python,
# ZIP archives and private reports do not enter the web container.
